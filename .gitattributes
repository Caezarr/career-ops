# Normalize line endings for text files committed to the repo.
* text=auto eol=lf

*.ts   text
*.tsx  text
*.js   text
*.mjs  text
*.json text
*.html text
*.css  text
*.rs   text
*.toml text
*.md   text diff=markdown
*.yml  text
*.yaml text
*.sh   text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.mp4  binary
*.woff binary
*.woff2 binary
*.dmg  binary

# Generated lockfiles: hide from diffs and language stats
pnpm-lock.yaml -diff linguist-generated=true
src-tauri/Cargo.lock -diff linguist-generated=true
